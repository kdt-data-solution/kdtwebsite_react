# Configure this on the Express server only. Never put the key in frontend/.env
# or in the public site settings table.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Leave at 0 unless Express is behind a known, trusted reverse proxy.
# For exactly one trusted proxy hop, set TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=0
